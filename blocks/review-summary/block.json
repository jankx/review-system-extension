{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/review-summary",
    "title": "Review Summary",
    "category": "jankx",
    "icon": "star-filled",
    "description": "Hiển thị tổng quan đánh giá với biểu đồ phân bố điểm.",
    "textdomain": "jankx",
    "usesContext": ["postId", "postType"],
    "attributes": {
        "showDistribution": { "type": "boolean", "default": true },
        "maxStars": { "type": "number", "default": 5 }
    },
    "styles": [
        { "name": "default", "label": "Mặc định", "isDefault": true },
        { "name": "badge", "label": "Huy hiệu (Nhỏ gọn)" }
    ],
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": { "margin": true, "padding": true }
    },
    "editorScript": "file:./build/index.js",
    "style": "file:./build/style.css",
    "editorStyle": "file:./build/editor.css"
}
