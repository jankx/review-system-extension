{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/reviews-my-reviews",
    "title": "My Reviews",
    "category": "jankx",
    "icon": "star-filled",
    "description": "Reviews written by the user.",
    "textdomain": "jankx",
    "editorScript": "file:./build/index.tsx.js",
    "parent": ["jankx/account-tab-reviews"],
    "attributes": {
        "jankxHideOnUltrawide": { "type": "boolean", "default": false },
        "jankxHideOnPc": { "type": "boolean", "default": false },
        "jankxHideOnTablet": { "type": "boolean", "default": false },
        "jankxHideOnMobile": { "type": "boolean", "default": false },
        "jankxFlexGrow": { "type": "boolean", "default": false }
    },
    "supports": { "html": false, "inserter": false }
}